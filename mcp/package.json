{
  "name": "classicuo-ua-mcp",
  "version": "1.0.0",
  "description": "MCP server — ClassicUO Web Client scripting context for Ultima Alianza",
  "main": "dist/server.js",
  "bin": {
    "classicuo-ua-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "npx ts-node src/server.ts"
  },
  "files": [
    "dist/",
    "resources/"
  ],
  "keywords": ["mcp", "classicuo", "ultima-online", "ultima-alianza", "scripting"],
  "author": "sirdrunk",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3"
  },
  "pkg": {
    "scripts": "dist/server.js",
    "assets": "resources/**/*",
    "targets": ["node20-win-x64"],
    "outputPath": "bin"
  }
}

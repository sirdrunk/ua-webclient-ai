{
  "name": "classicuo-ua-mcp",
  "version": "1.0.0",
  "description": "MCP server — ClassicUO Web Client scripting context for Ultima Alianza",
  "main": "dist/server.js",
  "bin": {
    "classicuo-ua-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "node scripts/bundle.js",
    "exe": "npx @yao-pkg/pkg dist/bundle.js --targets node20-win-x64 --output bin/classicuo-ua-mcp.exe --assets \"resources/**/*\"",
    "set-icon": "node scripts/set-icon.js",
    "test": "node scripts/test-exe.js",
    "build:exe": "npm run build && npm run bundle && npm run exe && npm run set-icon && npm test",
    "start": "node dist/server.js",
    "dev": "npx ts-node src/server.ts"
  },
  "files": [
    "dist/",
    "resources/"
  ],
  "keywords": [
    "mcp",
    "classicuo",
    "ultima-online",
    "ultima-alianza",
    "scripting"
  ],
  "author": "sirdrunk",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@yao-pkg/pkg": "^6.14.2",
    "esbuild": "^0.28.1",
    "png-to-ico": "^3.0.1",
    "rcedit": "^4.0.1",
    "resedit": "^3.0.2",
    "typescript": "^6.0.3"
  },
  "pkg": {
    "scripts": "dist/server.js",
    "assets": "resources/**/*",
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "bin"
  }
}
